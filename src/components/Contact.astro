<section class="section" id="contact">
  <div class="container contact-inner">
    <div class="contact-copy reveal">
      <p class="eyebrow">Find Us &amp; Get in Touch</p>
      <h2>Talk to our team</h2>
      <p class="lede">Tell us about your space and we'll get back to you.</p>
      <ul class="contact-meta">
        <li>Yan Studio Design &amp; Build Sdn Bhd, [Street Address], [City]</li>
        <li>Studio hours: Mon–Fri 9am–6pm</li>
        <li><a href="mailto:hello@yaninteriordesign.com">hello@yaninteriordesign.com</a></li>
      </ul>
    </div>

    <!--
      HubSpot form embed — placeholder IDs.
      Replace YOUR_PORTAL_ID and YOUR_FORM_ID with the values from
      HubSpot: Marketing > Forms > your form > Embed code.
    -->
    <div class="hs-form-wrapper reveal">
      <div id="hubspotForm"></div>
      <noscript>
        <p>Please enable JavaScript to view the contact form, or email us directly at
          <a href="mailto:hello@yaninteriordesign.com">hello@yaninteriordesign.com</a>.
        </p>
      </noscript>
    </div>
  </div>
</section>

<script src="https://js.hsforms.net/forms/embed/v2.js" is:inline></script>
<script is:inline>
  if (window.hbspt) {
    window.hbspt.forms.create({
      portalId: 'YOUR_PORTAL_ID',
      formId: 'YOUR_FORM_ID',
      target: '#hubspotForm',
    });
  }
</script>

<style>
  .contact-inner {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 72px;
  }

  .contact-meta {
    list-style: none;
    padding: 0;
    margin: 28px 0 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .contact-meta a { color: var(--gold); font-weight: 600; }

  .hs-form-wrapper {
    border: 1px solid var(--line);
    padding: 32px;
    min-height: 200px;
  }

  @media (max-width: 860px) {
    .contact-inner { grid-template-columns: 1fr; gap: 40px; }
  }
</style>
