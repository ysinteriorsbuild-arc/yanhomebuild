        </div>
        <div class="work-info">
          <strong>Boutique Retail Fit-out</strong>
          <span>[City], [Region]</span>
        </div>
      </div>

      <div class="work-item reveal" data-category="fabrication">
        <div class="work-thumb gradient-border">
          <img src="https://images.pexels.com/photos/32062853/pexels-photo-32062853.jpeg?auto=compress&cs=tinysrgb&w=800" alt="Custom kitchen millwork" width="800" height="600" loading="lazy" />
        </div>
        <div class="work-info">
          <strong>Custom Kitchen Millwork</strong>
          <span>[City], [Region]</span>
        </div>
      </div>

      <div class="work-item reveal" data-category="residential">
        <div class="work-thumb gradient-border">
          <img src="https://images.pexels.com/photos/16436912/pexels-photo-16436912.jpeg?auto=compress&cs=tinysrgb&w=800" alt="Primary bedroom suite" width="800" height="600" loading="lazy" />
        </div>
        <div class="work-info">
          <strong>Primary Bedroom Suite</strong>
          <span>[City], [Region]</span>
        </div>
      </div>

      <div class="work-item reveal" data-category="commercial">
        <div class="work-thumb gradient-border">
          <img src="https://images.pexels.com/photos/32334270/pexels-photo-32334270.jpeg?auto=compress&cs=tinysrgb&w=800" alt="Office reception build" width="800" height="600" loading="lazy" />
