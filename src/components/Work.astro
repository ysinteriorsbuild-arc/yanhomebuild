<style>
  .work-filters { display: flex; gap: 28px; }

  .filter-btn {
    background: none;
    border: none;
    padding: 0 0 6px;
    font-family: var(--font);
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--text-muted);
    border-bottom: 1px solid transparent;
    cursor: pointer;
    transition: color 0.3s var(--ease), border-color 0.3s var(--ease);
  }

  .filter-btn:hover { color: var(--text); }
  .filter-btn.is-active {
    border-color: var(--gold);
    background: var(--gold-gradient-text);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .work-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
  }

  .work-item.is-hidden { display: none; }

  .work-item { transition: transform 0.45s var(--ease); }
  .work-item:hover { transform: translateY(-6px); }

  .work-thumb {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    transition: box-shadow 0.45s var(--ease);
  }

  .work-item:hover .work-thumb { box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4); }

  .work-thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s var(--ease); }
  .work-item:hover .work-thumb img { transform: scale(1.04); }

  .work-info { margin-top: 16px; display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
  .work-info strong { font-size: 0.95rem; font-weight: 600; }
  .work-info span { font-size: 0.78rem; color: var(--text-muted); }

  .ba-block { margin-top: 120px; }
  .ba-title { margin-bottom: 40px; }

  .ba-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
  }

  .ba-slider {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    user-select: none;
  }

  .ba-after, .ba-before-wrap img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ba-before-wrap {
    position: absolute;
    inset: 0;
    clip-path: inset(0 50% 0 0);
    overflow: hidden;
  }

  .ba-range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
  }

  .ba-handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
    background: rgba(255, 255, 255, 0.8);
    transform: translateX(-50%);
    pointer-events: none;
  }

  .ba-handle::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: #fff;
    transform: translate(-50%, -50%);
  }

  .ba-label {
    position: absolute;
    bottom: 14px;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #fff;
    background: rgba(10, 21, 38, 0.65);
    padding: 5px 11px;
    pointer-events: none;
  }

  .ba-label-before { left: 14px; }
  .ba-label-after { right: 14px; }

  @media (max-width: 860px) {
    .section-head { align-items: flex-start; }
    .work-grid { grid-template-columns: 1fr 1fr; gap: 24px; }
    .ba-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 560px) {
    .work-grid { grid-template-columns: 1fr; }
  }
</style>
