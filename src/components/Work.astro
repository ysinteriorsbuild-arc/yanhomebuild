        <button class="filter-btn" data-filter="residential">Residential</button>
        <button class="filter-btn" data-filter="commercial">Commercial</button>
        <button class="filter-btn" data-filter="fabrication">Fabrication</button>
      </div>
    </div>

    <div class="work-grid" id="workGrid">
      <div class="work-item reveal" data-category="residential">
        <div class="work-thumb gradient-border">
          <img src="https://images.pexels.com/photos/28539228/pexels-photo-28539228.jpeg?auto=compress&cs=tinysrgb&w=800" alt="Residential living room" width="800" height="600" loading="lazy" />
        </div>
        <div class="work-info">
