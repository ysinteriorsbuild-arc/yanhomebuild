        <div class="work-thumb gradient-border">
          <img src="https://images.pexels.com/photos/14957889/pexels-photo-14957889.jpeg?auto=compress&cs=tinysrgb&w=800" alt="Built-in media console" width="800" height="600" loading="lazy" />
        </div>
        <div class="work-info">
          <strong>Built-in Media Console</strong>
          <span>[City], [Region]</span>
        </div>
      </div>
    </div>

    <div class="ba-block reveal">
      <p class="eyebrow">See The Transformation</p>
      <h3 class="ba-title">Before &amp; after</h3>
      <div class="ba-grid">
        <div class="ba-slider gradient-border" data-ba>
          <img class="ba-after" src="https://images.pexels.com/photos/29012625/pexels-photo-29012625.jpeg?auto=compress&cs=tinysrgb&w=800" alt="After renovation" />
          <div class="ba-before-wrap">
            <img class="ba-before" src="https://images.pexels.com/photos/35493907/pexels-photo-35493907.jpeg?auto=compress&cs=tinysrgb&w=800" alt="Before renovation" />
          </div>
          <input type="range" min="0" max="100" value="50" class="ba-range" aria-label="Drag to compare before and after" />
          <div class="ba-handle"></div>
          <span class="ba-label ba-label-before">Before</span>
          <span class="ba-label ba-label-after">After</span>
        </div>
        <div class="ba-slider gradient-border" data-ba>
          <img class="ba-after" src="https://images.pexels.com/photos/27390284/pexels-photo-27390284.jpeg?auto=compress&cs=tinysrgb&w=800" alt="After renovation" />
          <div class="ba-before-wrap">
            <img class="ba-before" src="https://images.pexels.com/photos/36035073/pexels-photo-36035073.jpeg?auto=compress&cs=tinysrgb&w=800" alt="Before renovation" />
          </div>
          <input type="range" min="0" max="100" value="50" class="ba-range" aria-label="Drag to compare before and after" />
          <div class="ba-handle"></div>
          <span class="ba-label ba-label-before">Before</span>
          <span class="ba-label ba-label-after">After</span>
