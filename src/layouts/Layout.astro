---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Yan Studio Design & Build Sdn Bhd — Curated Spaces, Built for Living',
  description = 'Yan Studio Design & Build Sdn Bhd designs and fabricates custom interiors — from concept to built-in furniture, for homes and commercial spaces.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,400;0,500;0,600;0,700;0,800;1,500;1,600&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/png" href="/assets/favicon.png" />
  </head>
  <body>
    <div class="ambient-bg" aria-hidden="true">
      <span class="ambient-streak ambient-streak-a"></span>
      <span class="ambient-streak ambient-streak-b"></span>
      <span class="ambient-streak ambient-streak-c"></span>
      <span class="ambient-shine"></span>
    </div>
    <slot />
    <script src="../scripts/main.ts"></script>
  </body>
</html>
